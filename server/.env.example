# 复制为 .env 后按需修改
PORT=3001
# 0.0.0.0 允许局域网访问；只给本机用可改 127.0.0.1
HOST=0.0.0.0
NODE_ENV=development

# 生产必须替换成随机长字符串
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-local-secret-please-change-in-prod
JWT_EXPIRES_IN=7d

# 数据与判题临时目录（默认 server/data 下）
# DB_PATH=./data/oj.db
# JUDGE_WORK_DIR=./data/judge

JUDGE_CONCURRENCY=2
SUBMIT_COOLDOWN_SEC=1
RUN_COOLDOWN_MS=2000

# 前后端分开部署时改成前端地址
CORS_ORIGIN=http://localhost:5173
